nas_ssh_user     = "rainforest"
nas_ssh_host     = "<nas>.<teleport-proxy>"
remote_write_url = "http://<pi-tailnet-ip>:30090/api/v1/write"
unifi_url        = "https://<work-vlan-gateway>"
ap_snmp_address  = "<nwa130be-lan-ip>"

lan_ping_targets = {
  ucg-ultra      = "<ucg-lan-ip>"
  usw-flex-xg    = "<switch-lan-ip>"
  ap-nwa130be    = "<nwa130be-lan-ip>"
  ap-nwa50ax-pro = "<nwa50ax-pro-lan-ip>"
}

# SNMPv3 user from DSM -> Terminal & SNMP -> SNMPv3 (SHA + AES).
snmp_v3_username      = "alloy"
snmp_v3_auth_password = "<auth password>"
snmp_v3_priv_password = "<privacy password>"

# NWA130BE: v2c community from the Nebula site settings.
ap_snmp_community = "<community>"

# Either a View Only local admin on the UCG Ultra (least privilege)...
unifi_user = "unpoller"
unifi_pass = "<password>"

# ...or a UniFi Network API key (Settings -> Control Plane -> Integrations).
# unifi_api_key = "<key>"
