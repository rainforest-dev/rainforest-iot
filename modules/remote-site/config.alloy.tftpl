prometheus.remote_write "pi" {
  external_labels = {
    site = "${site}",
  }
  endpoint {
    url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")
  }
}

prometheus.exporter.blackbox "isp" {
  config = "{ modules: { icmp: { prober: icmp, timeout: 5s, icmp: { preferred_ip_protocol: ip4 } } } }"
%{ for name, address in isp_ping_targets ~}
  target {
    name    = "${name}"
    address = "${address}"
    module  = "icmp"
  }
%{ endfor ~}
}

discovery.relabel "isp" {
  targets = prometheus.exporter.blackbox.isp.targets

  rule {
    source_labels = ["job"]
    regex         = "integrations/[^/]+/(.*)"
    target_label  = "target"
  }

  rule {
    target_label = "job"
    replacement  = "isp_icmp"
  }
}

prometheus.scrape "isp" {
  job_name        = "isp_icmp"
  targets         = discovery.relabel.isp.output
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.pi.receiver]
}
%{ if length(lan_ping_targets) > 0 ~}

prometheus.exporter.blackbox "lan" {
  config = "{ modules: { icmp: { prober: icmp, timeout: 5s, icmp: { preferred_ip_protocol: ip4 } } } }"
%{ for name, address in lan_ping_targets ~}
  target {
    name    = "${name}"
    address = "${address}"
    module  = "icmp"
  }
%{ endfor ~}
}

discovery.relabel "lan" {
  targets = prometheus.exporter.blackbox.lan.targets

  rule {
    source_labels = ["job"]
    regex         = "integrations/[^/]+/(.*)"
    target_label  = "target"
  }

  rule {
    target_label = "job"
    replacement  = "lan_icmp"
  }
}

prometheus.scrape "lan" {
  job_name        = "lan_icmp"
  targets         = discovery.relabel.lan.output
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.pi.receiver]
}
%{ endif ~}
%{ if length(snmp_targets) > 0 ~}

prometheus.exporter.snmp "site" {
  config_merge_strategy = "merge"
  config                = "auths:\n  site_v3:\n    version: 3\n    security_level: authPriv\n    username: \"" + sys.env("SNMP_V3_USERNAME") + "\"\n    auth_protocol: SHA\n    password: \"" + sys.env("SNMP_V3_AUTH_PASSWORD") + "\"\n    priv_protocol: AES\n    priv_password: \"" + sys.env("SNMP_V3_PRIV_PASSWORD") + "\"\n  site_v2:\n    version: 2\n    community: \"" + sys.env("SNMP_COMMUNITY") + "\"\n"
%{ for name, t in snmp_targets ~}

  target "${name}" {
    address = "${t.address}"
    module  = "${t.module}"
    auth    = "site_${t.auth}"
  }
%{ endfor ~}
}

discovery.relabel "snmp" {
  targets = prometheus.exporter.snmp.site.targets

  rule {
    source_labels = ["job"]
    regex         = "integrations/[^/]+/(.*)"
    target_label  = "target"
  }

  rule {
    target_label = "job"
    replacement  = "snmp"
  }
}

prometheus.scrape "snmp" {
  job_name        = "snmp"
  targets         = discovery.relabel.snmp.output
  scrape_interval = "60s"
  scrape_timeout  = "30s"
  forward_to      = [prometheus.remote_write.pi.receiver]
}
%{ endif ~}
%{ if length(node_targets) > 0 ~}

prometheus.scrape "node" {
  job_name = "site-node"
  targets  = [
%{ for name, address in node_targets ~}
    { "__address__" = "${address}", "instance" = "${name}" },
%{ endfor ~}
  ]
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.pi.receiver]
}
%{ endif ~}

prometheus.scrape "unpoller" {
  job_name        = "unpoller"
  targets         = [{ "__address__" = "unpoller:9130" }]
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.pi.receiver]
}

prometheus.scrape "speedtest" {
  job_name        = "speedtest"
  targets         = [{ "__address__" = "speedtest:9798" }]
  scrape_interval = "60m"
  scrape_timeout  = "90s"
  forward_to      = [prometheus.remote_write.pi.receiver]
}
